---
import { education } from '../data/education';
---
<section class="section" id="education">
  <div class="wrap">
    <div class="sec-hd">
      <div class="sec-n">04</div>
      <h2 class="sec-t">Education</h2>
    </div>
    <div class="edu-grid">
      {education.map(e => (
        <div class="edu-card">
          <div class="edu-deg">{e.degree}</div>
          <div class="edu-inst">{e.institution}</div>
          <div class="edu-yr">{e.years}</div>
        </div>
      ))}
    </div>
  </div>
</section>
