---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  frontmatter: {
    title?: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{frontmatter.title ?? site.title}</title>
  <meta name="description" content={frontmatter.description ?? ''} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,700&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
  <style>
    /* ── Base ── */
    body {
      background: var(--bg);
      color: var(--ink);
      font-family: 'IBM Plex Sans', sans-serif;
      max-width: 840px;
      margin: 0 auto;
      padding: 0 2rem 6rem;
      line-height: 1.75;
      font-size: 1rem;
    }

    /* ── Page top bar ── */
    .doc-topbar {
      border-bottom: 2px solid var(--ink);
      padding: 1.25rem 0 1rem;
      margin-bottom: 3rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .doc-home {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.68rem;
      color: var(--ink4);
      text-decoration: none;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .doc-home:hover { color: var(--red); }
    .doc-stamp {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--red);
      border: 1px solid var(--red);
      padding: 0.2rem 0.6rem;
      opacity: 0.7;
    }

    /* ── Headings ── */
    h1 {
      font-family: 'Fraunces', serif;
      font-size: clamp(2rem, 5vw, 2.8rem);
      font-weight: 900;
      line-height: 1.05;
      letter-spacing: -0.025em;
      margin-bottom: 0.35rem;
      color: var(--ink);
    }
    .doc-meta {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.68rem;
      color: var(--ink4);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 2rem;
    }
    h2 {
      font-family: 'Fraunces', serif;
      font-size: 1.45rem;
      font-weight: 700;
      margin-top: 3.5rem;
      margin-bottom: 1.1rem;
      padding-top: 1.75rem;
      border-top: 2px solid var(--ink);
      color: var(--ink);
      letter-spacing: -0.015em;
    }
    h2:first-of-type { border-top: none; padding-top: 0; margin-top: 1.5rem; }
    h3 {
      font-family: 'Fraunces', serif;
      font-size: 1.1rem;
      font-weight: 600;
      margin-top: 2rem;
      margin-bottom: 0.85rem;
      color: var(--ink);
      letter-spacing: -0.01em;
    }
    h4 {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--red);
      margin-top: 1.5rem;
      margin-bottom: 0.65rem;
    }

    /* ── Body copy ── */
    p { margin-bottom: 1rem; font-size: 0.95rem; color: var(--ink2); }
    p strong { color: var(--ink); font-weight: 600; }
    ul, ol { padding-left: 1.5rem; margin-bottom: 1.1rem; }
    li { font-size: 0.93rem; margin-bottom: 0.5rem; color: var(--ink2); line-height: 1.7; }
    li strong { color: var(--ink); }
    a { color: var(--red); text-decoration: none; }
    a:hover { text-decoration: underline; }
    hr {
      border: none;
      border-top: 2px solid var(--bdr);
      margin: 2.5rem 0;
    }

    /* ── Inline code ── */
    code {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.82rem;
      background: var(--stone);
      color: var(--ink2);
      padding: 0.1em 0.4em;
      border-radius: 2px;
    }

    /* ── Code / template blocks ── */
    pre {
      background: var(--paper);
      border: 1px solid var(--bdr);
      border-left: 4px solid var(--ink3);
      padding: 1.1rem 1.3rem;
      margin: 2rem 0;
      overflow-x: auto;
      border-radius: 0 3px 3px 0;
    }
    pre code {
      background: none;
      color: var(--ink2);
      padding: 0;
      font-size: 0.81rem;
      line-height: 1.75;
      border-radius: 0;
    }

    /* ── Blockquote (key insight / highlight) ── */
    blockquote {
      border-left: 4px solid var(--red);
      padding: 0.85rem 1.1rem;
      margin: 1.75rem 0;
      background: var(--red-bg);
      color: var(--ink2);
      font-size: 0.94rem;
    }
    blockquote p { margin: 0; color: inherit; font-size: inherit; }
    blockquote strong { color: var(--red); }

    /* ── Callout boxes ── */
    .callout {
      background: var(--blue-bg);
      border-left: 4px solid var(--blue);
      padding: 0.9rem 1.1rem;
      margin: 1.5rem 0;
      border-radius: 0 3px 3px 0;
    }
    .callout p { margin: 0 0 0.4rem; font-size: 0.93rem; }
    .callout p:last-child { margin-bottom: 0; }
    .callout strong { color: var(--blue); }

    .tip {
      background: var(--teal-bg);
      border-left: 4px solid var(--teal);
      padding: 0.9rem 1.1rem;
      margin: 1.5rem 0;
      border-radius: 0 3px 3px 0;
    }
    .tip p { margin: 0 0 0.4rem; font-size: 0.93rem; }
    .tip p:last-child { margin-bottom: 0; }
    .tip strong { color: var(--teal); }

    .warn {
      background: var(--red-bg);
      border-left: 4px solid var(--red);
      padding: 0.9rem 1.1rem;
      margin: 1.5rem 0;
      border-radius: 0 3px 3px 0;
    }
    .warn p { margin: 0 0 0.4rem; font-size: 0.93rem; }
    .warn p:last-child { margin-bottom: 0; }
    .warn strong { color: var(--red); }

    /* ── Tables ── */
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 2rem 0;
      font-size: 0.88rem;
      border: 2px solid var(--ink);
    }
    thead { background: var(--stone); }
    th {
      text-align: left;
      padding: 0.6rem 0.9rem;
      border-bottom: 2px solid var(--ink);
      border-right: 1px solid var(--bdr);
      font-weight: 600;
      color: var(--ink);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.68rem;
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }
    th:last-child { border-right: none; }
    td {
      padding: 0.6rem 0.9rem;
      border-bottom: 1px solid var(--bdr);
      border-right: 1px solid var(--bdr);
      color: var(--ink2);
      vertical-align: top;
    }
    td:last-child { border-right: none; }
    tbody tr:nth-child(even) { background: var(--paper); }
    tbody tr:last-child td { border-bottom: none; }
    td strong { color: var(--ink); }

    /* ── Table of contents ── */
    .toc {
      background: var(--paper);
      border: 1px solid var(--bdr);
      border-top: 3px solid var(--ink);
      padding: 1.1rem 1.3rem 1.1rem;
      margin: 2rem 0 2.5rem;
    }
    .toc-title {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.65rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink4);
      margin-bottom: 0.75rem;
    }
    .toc ol {
      margin: 0;
      padding-left: 1.25rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 1.5rem;
    }
    .toc li {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.73rem;
      margin-bottom: 0.3rem;
      color: var(--ink3);
      break-inside: avoid;
    }
    .toc a { color: var(--ink3); text-decoration: none; }
    .toc a:hover { color: var(--red); }

    /* ── Service cards ── */
    .service {
      background: var(--paper);
      border: 1px solid var(--bdr);
      border-left: 4px solid var(--teal);
      padding: 1.25rem 1.4rem;
      margin: 1.5rem 0;
    }
    .service h3 {
      color: var(--teal);
      font-size: 1rem;
      margin-top: 0;
      margin-bottom: 0.6rem;
      border: none;
      padding: 0;
      font-family: 'Fraunces', serif;
    }
    .service p { font-size: 0.9rem; }
    .service table { margin: 0.75rem 0 0; font-size: 0.82rem; }
    .service td, .service th { padding: 0.4rem 0.65rem; }

    /* ── Phase labels in timeline ── */
    .phase {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      margin: 2.75rem 0 0.75rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--bdr);
    }
    .phase-n {
      font-family: 'Fraunces', serif;
      font-weight: 900;
      font-size: 2.2rem;
      color: var(--stone2);
      line-height: 1;
      flex-shrink: 0;
    }
    .phase-l {
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.72rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.09em;
      color: var(--ink3);
    }

    /* ── Responsive ── */
    @media (max-width: 640px) {
      body { padding: 0 1.25rem 4rem; }
      .toc ol { grid-template-columns: 1fr; }
    }

    /* ── Print ── */
    @media print {
      body { background: white; color: black; max-width: 100%; padding: 0 1.5cm; }
      .doc-topbar { display: none; }
      h2 { page-break-before: always; border-top: none; padding-top: 0; }
      h2:first-of-type { page-break-before: avoid; }
      pre, .callout, .tip, .warn, blockquote { page-break-inside: avoid; }
      a { color: inherit; text-decoration: none; }
    }
  </style>
</head>
<body>
  <div class="doc-topbar">
    <a href="/" class="doc-home">← datawithaditya</a>
    <span class="doc-stamp">Private · Not Indexed</span>
  </div>
  <slot />
</body>
</html>
